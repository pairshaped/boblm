#!/usr/bin/env bash
# Behavior test for bin/restart against a fake database and a fake systemctl.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
work=$(mktemp -d "$here/../target/restart-test.XXXXXX")
trap '[[ -z ${proof_pid:-} ]] || kill "$proof_pid" 2>/dev/null || true; rm -rf "$work"' EXIT
fail() { echo "FAIL: $*"; exit 1; }

mkdir -p "$work/bin"
cat > "$work/bin/systemctl" <<SH
#!/usr/bin/env bash
if [[ \$* == *MainPID* ]]; then echo 123; exit 0; fi
echo "\$*" >> "$work/calls"
SH
chmod +x "$work/bin/systemctl"
export PATH="$work/bin:$PATH" BOBLM_DB="$work/db.sqlite" BOBLM_SETTLE=0

sqlite3 "$BOBLM_DB" "
  pragma journal_mode=wal;
  create table sessions (id text, name text, archived integer);
  create table events (session text, seq integer, kind text, payload text);
  create table messages (uuid text, session text, seq integer, delivery_state text);
  insert into sessions values ('a', 'Busy chat', 0), ('b', 'Idle chat', 0), ('c', 'Archived busy', 1);
  insert into events values
    ('a', 1, 'state_summary', '{\"turnActive\":true,\"dispatching\":0,\"stopping\":false}'),
    ('b', 1, 'state_summary', '{\"turnActive\":true,\"dispatching\":0,\"stopping\":false}'),
    ('b', 2, 'state_summary', '{\"turnActive\":false,\"dispatching\":0,\"stopping\":false}'),
    ('c', 1, 'state_summary', '{\"turnActive\":true,\"dispatching\":0,\"stopping\":false}');" >/dev/null
calls() { cat "$work/calls" 2>/dev/null || true; }

# A busy chat blocks the restart, and only that chat is named.
out=$("$here/restart" 2>&1) && fail "should refuse while a chat is mid-turn"
grep -q "Busy chat" <<<"$out" || fail "should name the busy chat"
grep -q "Idle chat\|Archived busy" <<<"$out" && fail "idle and archived chats must not be listed"
[[ -z $(calls) ]] || fail "systemctl must not run when refusing"

# --wait gives up after its window, still without restarting.
"$here/restart" --wait 1 >/dev/null 2>&1 && fail "--wait should refuse after the window"
[[ -z $(calls) ]] || fail "systemctl must not run after a timed-out wait"

# --wait proceeds once the chat goes idle.
( sleep 1; sqlite3 "$BOBLM_DB" "insert into events values ('a', 2, 'state_summary', '{\"turnActive\":false,\"dispatching\":0,\"stopping\":false}')" ) &
"$here/restart" --wait 10 >/dev/null || fail "--wait should restart once idle"
grep -q "restart boblm" <<<"$(calls)" || fail "--wait should restart the unit"
wait

# --force restarts regardless.
sqlite3 "$BOBLM_DB" "insert into events values ('a', 3, 'state_summary', '{\"turnActive\":false,\"dispatching\":1,\"stopping\":false}')"
rm -f "$work/calls"
"$here/restart" >/dev/null 2>&1 && fail "a dispatching chat is busy"
"$here/restart" --force >/dev/null || fail "--force should restart"
grep -q "restart boblm" <<<"$(calls)" || fail "--force should restart the unit"

# Accepted but unstarted work counts as busy, even when no turn is active yet.
sqlite3 "$BOBLM_DB" "insert into events values ('a', 4, 'state_summary', '{\"turnActive\":false,\"dispatching\":0,\"stopping\":false,\"queueHeld\":false}');
  insert into messages values ('m1', 'a', 1, 'queued');"
rm -f "$work/calls"
out=$("$here/restart" 2>&1) && fail "a queued message in a chat that is not held must block the restart"
grep -q "Busy chat" <<<"$out" || fail "should name the chat with queued work"
[[ -z $(calls) ]] || fail "systemctl must not run with queued work"

# A held queue never starts on its own, so it must not block a restart forever.
sqlite3 "$BOBLM_DB" "insert into events values ('a', 5, 'state_summary', '{\"turnActive\":false,\"dispatching\":0,\"stopping\":false,\"queueHeld\":true}')"
"$here/restart" >/dev/null || fail "queued messages behind a held queue should not block"
grep -q "restart boblm" <<<"$(calls)" || fail "held queue should still restart"

# Work that appears during the settle pause is caught by the second check.
sqlite3 "$BOBLM_DB" "insert into events values ('a', 6, 'state_summary', '{\"turnActive\":false,\"dispatching\":0,\"stopping\":false,\"queueHeld\":false}')"
rm -f "$work/calls"
sqlite3 "$BOBLM_DB" "update messages set delivery_state = 'started'"
( sleep 1; sqlite3 "$BOBLM_DB" "insert into messages values ('m2', 'a', 2, 'queued')" ) &
BOBLM_SETTLE=3 "$here/restart" >/dev/null 2>&1 && fail "work accepted during the settle pause must block the restart"
[[ -z $(calls) ]] || fail "systemctl must not run when work arrives during settling"
wait

# Background work outlives the turn and blocks restart independently of messages.
sqlite3 "$BOBLM_DB" "update messages set delivery_state = 'started';
  insert into events values ('a', 7, 'state_summary', '{\"turnActive\":false,\"dispatching\":0,\"stopping\":false,\"jobs\":{\"tasks\":[{\"id\":\"job-1\",\"command\":\"cargo test\"}],\"available\":true}}')"
rm -f "$work/calls"
out=$("$here/restart" 2>&1) && fail "background jobs must block an idle chat restart"
grep -q '1 background tasks in 1 chats' <<<"$out" || fail "should summarize background work"
[[ -z $(calls) ]] || fail "background jobs must prevent systemctl"
sqlite3 "$BOBLM_DB" "insert into events values ('a', 8, 'state_summary', '{\"turnActive\":false,\"dispatching\":0,\"stopping\":false,\"jobs\":{\"tasks\":[],\"available\":true}}')"
"$here/restart" >/dev/null || fail "completed background jobs should permit restart"

# A failed inventory must not be interpreted as an empty one.
sqlite3 "$BOBLM_DB" "insert into events values ('a', 9, 'state_summary', '{\"turnActive\":false,\"jobs\":{\"tasks\":[],\"available\":false}}')"
rm -f "$work/calls"
"$here/restart" >/dev/null 2>&1 && fail "unknown job inventory must block restart"
[[ -z $(calls) ]] || fail "unknown job inventory must prevent systemctl"

# An unreadable database is an error, not permission to restart.
rm -f "$work/calls"
BOBLM_DB="$work/missing.sqlite" "$here/restart" >/dev/null 2>&1 && fail "unknown activity must refuse"
[[ -z $(calls) ]] || fail "systemctl must not run when activity is unknown"

# Only a capability bound to the running unit PID can skip legacy busy guards.
cat > "$work/proof.py" <<'PYTHON'
import http.server, json, pathlib, sys
root = pathlib.Path(sys.argv[1])
class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, *args): pass
    def do_POST(self):
        self.rfile.read(int(self.headers.get('Content-Length', 0)))
        data = (root / 'claim.json').read_bytes()
        self.send_response(200); self.send_header('Content-Type','application/json'); self.end_headers(); self.wfile.write(data)
server = http.server.HTTPServer(('127.0.0.1',0), Handler)
(root / 'proof.json').write_text(json.dumps({'port':server.server_port,'token':'proof-fixture-token-only','database':str(root / 'db.sqlite')}))
server.serve_forever()
PYTHON
python3 "$work/proof.py" "$work" &
proof_pid=$!
for _ in $(seq 1 100); do [[ -f $work/proof.json ]] && break; sleep 0.01; done
export BOBLM_CONFIG="$work/proof.json"
printf '%s' '{"persistentRunners":false,"processId":123}' > "$work/claim.json"
"$here/restart" >/dev/null 2>&1 && fail "legacy server cannot bypass the job guard"
printf '%s' '{"persistentRunners":true,"processId":999}' > "$work/claim.json"
"$here/restart" >/dev/null 2>&1 && fail "another process cannot authorize a web-only restart"
printf '%s' '{"persistentRunners":true,"processId":123}' > "$work/claim.json"
rm -f "$work/calls"
"$here/restart" >/dev/null || fail "persistent runner server should permit restart with background jobs"
grep -q 'restart boblm' "$work/calls" || fail "persistent server should restart the web unit"
kill "$proof_pid"
wait "$proof_pid" 2>/dev/null || true
proof_pid=

echo "restart tests passed"

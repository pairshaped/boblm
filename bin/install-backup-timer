#!/usr/bin/env bash
# Install (or --remove) the nightly database backup timer as systemd user units (ADR 0053).
#   bin/install-backup-timer           copy the units, enable and start the timer
#   bin/install-backup-timer --remove  disable the timer and delete the units
# UNITS_DIR and SYSTEMCTL override the unit directory and systemctl, for tests.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
src="$here/../systemd"
units_dir=${UNITS_DIR:-$HOME/.config/systemd/user}
systemctl_bin=${SYSTEMCTL:-systemctl}
timer=boblm-db-backup.timer
units=(boblm-db-backup.service boblm-db-backup.timer)

case "${1:-}" in
  "")
    mkdir -p "$units_dir"
    for unit in "${units[@]}"; do
      install -m 0644 "$src/$unit" "$units_dir/$unit"
    done
    "$systemctl_bin" --user daemon-reload
    "$systemctl_bin" --user enable --now "$timer"
    "$systemctl_bin" --user list-timers "$timer" --no-legend
    ;;
  --remove)
    "$systemctl_bin" --user disable --now "$timer" || true
    for unit in "${units[@]}"; do
      rm -f "$units_dir/$unit"
    done
    "$systemctl_bin" --user daemon-reload
    echo "Removed the database backup timer."
    ;;
  *)
    echo "Usage: bin/install-backup-timer [--remove]" >&2
    exit 2
    ;;
esac

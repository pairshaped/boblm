[Unit]
Description=Back up and prune the SQLite database (BobLM)

[Service]
Type=oneshot
ExecStart=%h/projects/boblm/bin/backup-db
TimeoutStartSec=30min
Environment=PATH=%h/.local/bin:%h/.nix-profile/bin:/etc/profiles/per-user/dev/bin:/run/wrappers/bin:/run/current-system/sw/bin
Nice=19
IOSchedulingClass=idle
